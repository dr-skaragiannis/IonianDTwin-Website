# IonianDTwin — static deployment for ioniandtwin.di.ionio.gr
# Safe on Apache; ignored by Nginx/static hosts. All blocks are optional.

# Clean 404 page (also auto-routes known app paths to the SPA)
ErrorDocument 404 /404.html

# Prefer trailing-slash directory URLs (matches sitemap canonicals)
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# Compression for text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Long cache for fingerprinted/static assets, short for HTML
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Security headers (no sniffing / framing from other origins)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
